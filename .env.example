# Copy this file to the ignored local .env file; never commit the populated file.
AUTH_MODE=password
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=local-dev-password
SECRET_KEY=local-dev-only-secret-change-before-sharing
ADMIN_COOKIE_SECURE=0
PUBLIC_BASE_URL=http://127.0.0.1:8000
PUBLIC_GOODS_DB_PATH=./public_goods.dev.db
SQLITE_JOURNAL_MODE=WAL
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WRITE_RETRY_ATTEMPTS=4
SQLITE_WRITE_RETRY_BASE_DELAY_MS=100
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
